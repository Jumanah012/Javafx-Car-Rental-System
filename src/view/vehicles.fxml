<AnchorPane prefHeight="317.0" prefWidth="527.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="controller.VehiclesController">
    <children>
        <VBox alignment="TOP_CENTER" layoutX="50.0" layoutY="20.0" spacing="20.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
            <children>
                <Label text="Available Vehicles">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>
                <ListView fx:id="vehiclesListView" prefHeight="200.0" prefWidth="400.0"/>
                <Button onAction="#handleSubmit" prefWidth="100" text="Submit" />
            </children>
        </VBox>
    </children>
</AnchorPane>
