<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="310.0" prefWidth="460.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MainController">
    <children>
        <VBox alignment="CENTER" spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>
                <Label text="How can we help you Today?" textFill="#3232dd">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>
                <Button onAction="#handleBrowseVehicles" prefWidth="200" text="Browse available vehicles" textFill="#1f3991" />
                <!-- Administrator Controls Button -->
                <Button fx:id="adminButton" onAction="#handleAdminDashboard" prefWidth="200" text="Administrator Controls" textFill="#212ec0" />
                <!-- RentalAgent Controls Button -->
                <Button fx:id="rentalAgentButton" onAction="#handleRentalAgentDashboard" prefWidth="200" text="RentalAgent Controls" textFill="#2d4add" />
            </children>
        </VBox>
    </children>
</AnchorPane>
