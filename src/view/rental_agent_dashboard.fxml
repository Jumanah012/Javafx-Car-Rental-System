<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="330.0" prefWidth="682.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.RentalAgentController">
    <children>
        <VBox alignment="CENTER" spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>
                <Label text="RentalAgent" textFill="#2f4aaa">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
                <Label text="JDS Car Rentals" textFill="#386cb1">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>
                <HBox alignment="CENTER" spacing="20">
                    <children>
                        <Button onAction="#handleUpdateVehicleAvailability" prefWidth="200" text="Update Vehicle Availability" textFill="#2a4cbe" />
                        <Button onAction="#handleManageBookings" prefWidth="200" text="Manage Bookings" textFill="#1d4fb1" />
                        <Button onAction="#handleTrackRentalStatus" prefWidth="200" text="Track Rental Status" textFill="#1e33ba" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
